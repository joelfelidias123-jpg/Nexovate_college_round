DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require"
EMAIL_DRIVER=console
EMAIL_FROM=Nexus <no-reply@nexus.test>
DATABASE_PATH=.data/nexus.sqlite

# Fill these in only when EMAIL_DRIVER=smtp (use sandbox credentials, e.g. Mailtrap).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Optional. Enables server-side campaign drafts with Gemini.
GEMINI_API_KEY=

# Optional public base URL for campaign tracking links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional bearer token for scheduled campaign processing.
SCHEDULER_SECRET=
