DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require"
EMAIL_DRIVER=console
EMAIL_FROM=Nexus <no-reply@nexus.test>
DATABASE_PATH=.data/nexus.sqlite

# Fill these in only when EMAIL_DRIVER=smtp (use sandbox credentials, e.g. Mailtrap).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Optional. Enables server-side campaign drafts with Gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Optional generic OpenAI-compatible planner configuration (takes precedence over Gemini).
LLM_API_URL=
LLM_API_KEY=

# The agent uses safe mock P2/P4 tools by default; set to false only after wiring real API contracts.
USE_MOCKS=true
P2_API_URL=http://localhost:3000/api
P4_API_URL=http://localhost:3000/api

# Optional public base URL for campaign tracking links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional bearer token for scheduled campaign processing.
SCHEDULER_SECRET=
